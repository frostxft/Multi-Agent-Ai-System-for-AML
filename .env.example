# Set environment variables before starting Python; this file is not auto-loaded.
AML_DATA_DIR=data/elliptic/raw
AML_ARTIFACT_DIR=artifacts/benchmark
AML_DB_PATH=artifacts/cases.db
AML_MEDIUM_THRESHOLD=0.5
AML_HIGH_THRESHOLD=0.8
# extractive, local, or ollama. No silent fallback.
AML_LLM_PROVIDER=extractive
AML_LLM_MODEL=artifacts/flan-t5-small
AML_OLLAMA_URL=http://127.0.0.1:11434
# Optional Fernet key. Use a separate empty DB when changing encryption mode.
AML_ENCRYPTION_KEY=
# Independent strong tokens enable analyst/reviewer authorization.
AML_ANALYST_TOKEN=
AML_REVIEWER_TOKEN=
